// Site statique : wrangler publie out/ (produit par `pnpm build`) sans code Worker.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jds-top25",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "top25.needacoffee.fr", "custom_domain": true }]
}
